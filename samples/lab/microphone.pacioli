import geometry;
import graphics;
import graphics/parametric_plots;

define NORMAL_COLOR = make_color("green");
define DELTA_COLOR = make_color("red");
define LINE_COLOR = make_color("steelblue");
define MATERIAL = "Normal";

define PATH_COLOR = make_color("cyan");
define PATH2_COLOR = make_color("orange");  


# ------------------------------------------------------------------------------
# This file defines a scene of a parabolic microphone, based upon the parabolic reflector.
# See https://en.wikipedia.org/wiki/Parabolic_reflector for more information.
# ------------------------------------------------------------------------------


# ------------------------------------------------------------------------------
# The formula used for the surface ( z = \frac{d}{r^2} (x^2 + y^2) ) (where ( r ) is the radius and ( d ) is the depth) is derived from the
# standard equation of a paraboloid of revolution: ( z = \frac{x^2 + y^2}{4f} ).
# ------------------------------------------------------------------------------
declare microphone_surface :: for_unit a: (a, a) -> (a, radian) -> a*Geom3!;
define microphone_surface(radius, depth) =
    let
        a = depth / (radius^2)
    in
        (u, v) -> 
            vector3d(u*cos(v), u*sin(v), a * u^2)
    end;

# ------------------------------------------------------------------------------
# The formula used for the focal point ( f = \frac{r^2}{4d} ) (where ( r ) is the radius and ( d )
# is the depth) is derived from the standard equation of a paraboloid of revolution: ( z = \frac{x^2 + y^2}{4f} ).
# At the rim where ( x^2 + y^2 = r^2 ) and ( z = d ),
# substituting gives ( d = \frac{r^2}{4f} ), which rearranges to ( f = \frac{r^2}{4d} ).
# ------------------------------------------------------------------------------
declare focal_point :: for_unit a: (a, a) -> a;
define focal_point(radius, depth) = radius^2 / (4 * depth);


# ------------------------------------------------------------------------------
# The scene
# ------------------------------------------------------------------------------
declare paraboloid_scene :: for_type a, b: (centi:metre, centi:metre, centi:metre, radian, centi:metre, radian, 1, 1, 1, Boole, Boole, Boole, Boole, Boole, Boole) ->
    Scene(centi:metre, Geom3!);

define paraboloid_scene(radius, depth, x1, y1, x2, y2, n, m, d, grid, surface, wireframe, parts, total, normals) =
    let            
        range = 
            make_range(
                0*|centi:metre|, radius,
                0*|radian|, 2*pi*|radian|),

        options =
            tuple(n, m, d, grid, surface, wireframe, parts, total, normals),
        scene = build_example_scene(microphone_surface(radius, depth), range, options),
        z1 = microphone_surface(radius, depth)(x1, y1),
        z2 = microphone_surface(radius, depth)(x2, y2)
    in 
        add_lines(radius, depth, depth, z1, z2, scene)
    end;

declare add_lines :: for_unit a: (a, a, a, a*Geom3!, a*Geom3!, Scene(a, Geom3!)) -> Scene(a, Geom3!);

define add_lines(radius, depth, length, z1, z2  , scene) = 
    let
        f = focal_point(radius, depth),
        line_1 = make_line(f '.*' vector3d(0, 0, 1), z1, PATH_COLOR),
        line_2 = make_line(z1, z1 + length '.*' vector3d(0, 0, 1), PATH_COLOR),
        line_3 = make_line(f '.*' vector3d(0, 0, 1), z2, PATH2_COLOR),
        line_4 = make_line(z2, z2 + length '.*' vector3d(0, 0, 1), PATH2_COLOR)        
    in
        add_paths([line_1, line_2, line_3, line_4], scene)
    end;

# ------------------------------------------------------------------------------
# Computing the scene
# ------------------------------------------------------------------------------

define build_example_scene(fun, range, options) =
    let
        (n, m, d, grid, surface, wireframe, parts, total, normals) = options,

        plot_options =
            make_parametric_plot_options(
                n, m, 0.01, d,
                parts, total, normals, wireframe, MATERIAL,
                LINE_COLOR, DELTA_COLOR, NORMAL_COLOR),

        light_sources = [
            vector3d(50, 50, 50),
            vector3d(50, -50, 50),
            vector3d(-50, 50, 50),
            vector3d(-50, -50, 50)
        ],

        uom = unit(fun(range_ustart(range), range_vstart(range))),

        lights = [make_center_spot_light(vec * uom, 1000*|candela|) | vec <- light_sources]
    in
        begin
            scene := empty_scene("surface parametrization");

            scene := with_ambient_light("white", 0.3, scene);
            scene := add_spotlights(lights, scene);

            if surface then
                scene := plot_parametric_surface(fun, range, plot_options, scene);
            end
    
            if grid then
                scene := plot_parametric_surface_grid(fun, range, plot_options, scene);
            end

            if parts or total or normals then
                scene := plot_parametric_surface_deltas(fun, range, plot_options, scene);
            end

            return scene;
        end
    end;

declare make_center_spot_light :: 
    for_unit a, Geom3!u: (a*Geom3!u, candela) -> SpotLight(a, Geom3!u);

define make_center_spot_light(position, intensity) =
    make_spotlight(position, 0 '.*' position, make_color("white"), intensity);

