import testing;

run_test_suites([pi_suite]);

# ------------------------------------------------------------------------------
# Function pi_to_n_digits
# ------------------------------------------------------------------------------

doc pi_to_n_digits
    "BigNum pi with n digits.
    
    Gauss-Legendre";

declare pi_to_n_digits :: (1) -> BigNum;

define pi_to_n_digits(n) =
    begin
        printf("Calculating %d digits of pi", n);

        one := make_bignum("1");
        two := make_bignum("2");
        three := make_bignum("3");
        four := make_bignum("4");

        digits := (n+1)*|digits|;

        treshold := bignum_power(make_bignum("0.1"), n);

        a := one;
        b := bignum_divide(one, bignum_sqrt(two, digits), digits);
        t := make_bignum("0.25");
        p := one;

        s := bignum_add(a, b);

        old := make_bignum("0");

        i := 0;
        below_treshold := false;

        while not(below_treshold) do
            i := i + 1;

            a_new := bignum_divide(s, two, digits);
            b_new := bignum_sqrt(bignum_multiply(a, b), digits);

            d := bignum_subtract(a, a_new);
            t := bignum_subtract(t, bignum_multiply(p, bignum_multiply(d, d)));
            p := bignum_multiply(two, p);

            a := a_new;
            b := b_new;

            s := bignum_add(a, b);

            pi_digits := bignum_divide(bignum_divide(bignum_multiply(s, s), four, digits), t, digits);
            
            diff := bignum_subtract(pi_digits, old);

            below_treshold := bignum_compare(diff, treshold) < 0;

            old := pi_digits;

            printf("Step %2d. diff=%18.3e", i, diff);

        end

        printf("Done in %d steps", i);

        return pi_digits;
    end;

# ------------------------------------------------------------------------------
# Reference digits 
# ------------------------------------------------------------------------------

doc pi_1000_digits
    "Pi with 1000 digits. From the internet somewhere.";

define pi_1000_digits = "3.";

# ------------------------------------------------------------------------------
# Tests for pi_to_n_digits
# ------------------------------------------------------------------------------

define pi_1000 = pi_to_n_digits(1000);

define pi_digits = format("%1000f", pi_1000);

define pi_suite = test_suite("Function pi_to_n_digits", [
    test("should equal downloaded pi_1000_digits for n = 1000", () ->
        pi_1000_digits = pi_digits),

    test("should calc pi digits for large n (this test is for performance experiments)", () ->
        pi_to_n_digits(10000) != pi_1000)
]);

