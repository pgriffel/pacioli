export
    bignum_precision,
    set_bignum_precision;

defunit digits "digits";

# ----------------------------------------------------------------------------
# BigNum
# ----------------------------------------------------------------------------

doc bignum_precision
    "The BigNum precision. Used by square root and division to round the
    result.";

declare_primitive bignum_precision() ::
    () -> digits;

define bignum_precision() =
    _bignum_precision() * |digits|;

# ----------------------------------------------------------------------------

doc set_bignum_precision
    "Set the BigNum precision. Used by square root and division to round the
    result.";

declare_primitive set_bignum_precision(n) ::
    (digits) -> Void;

define set_bignum_precision(n) =
    _set_bignum_precision(n / |digits|);

