export
    make_bignum,
    bignum_add,
    bignum_subtract,
    bignum_multiply,
    _bignum_divide,
    bignum_power,
    _bignum_sqrt,
    bignum_compare;

# ----------------------------------------------------------------------------
# BigNum
# ----------------------------------------------------------------------------

doc make_bignum
    "Constructs a bignum from a numerical string. For example 
    make_bignum(\"12.345\")";

declare_primitive make_bignum(input) ::
    (String) -> BigNum;

# ----------------------------------------------------------------------------

doc bignum_add
    "Sums two BigNums";

declare_primitive bignum_add(x, y) ::
    (BigNum, BigNum) -> BigNum;

# ----------------------------------------------------------------------------

doc bignum_subtract
    "Difference between BigNums";

declare_primitive bignum_subtract(x, y) ::
    (BigNum, BigNum) -> BigNum;

# ----------------------------------------------------------------------------

doc bignum_multiply
    "Product of two BigNums";

declare_primitive bignum_multiply(x, y) ::
    (BigNum, BigNum) -> BigNum;

# ----------------------------------------------------------------------------

doc _bignum_divide
    "System function. Dimensionless primitive for dimensioned bignum_divide";

declare_primitive _bignum_divide(x, y, digits) ::
    (BigNum, BigNum, 1) -> BigNum;

# ----------------------------------------------------------------------------

doc bignum_power
    "Exponent of a BigNum";

declare_primitive bignum_power(x, n) ::
    (BigNum, 1) -> BigNum;

# ----------------------------------------------------------------------------

doc _bignum_sqrt
    "System function. Dimensionless primitive for dimensioned bignum_sqrt";

declare_primitive _bignum_sqrt(num, digits) ::
    (BigNum, 1) -> BigNum;

# ----------------------------------------------------------------------------

doc bignum_compare
    "Compares two BigNums. Returns -1, 0 or 1.";

declare_primitive bignum_compare(x, y) ::
    (BigNum, BigNum) -> 1;
