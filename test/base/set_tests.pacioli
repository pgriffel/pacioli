import testing;
# import random;
# import si;
# import testdata;
# import geometry;

declare set_suites :: List(TestSuite);

define set_suites = [
    set_equal_tests,
    set_size_tests,
    set_as_list_tests,
    set_as_set_tests,
    set_union_tests,
    set_set_contains_tests
];

run_test_suites(set_suites); 

