import testing;
import random;
import si;
import testdata;
import geometry;

declare misc_suites :: List(TestSuite);

define misc_suites = [
    comprehensions_suite,
    random_suite,
    equal_suite,
    defconv_suite
];

run_test_suites(misc_suites); 

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------

define is_upper_trianular(A) = 
    all[ get_num(A, i, j) = 0 |
        i <- row_domain(A),
        j <- column_domain(A),
        index_less(j, i)];

define is_lower_trianular(A) = 
    all[ get_num(A, i, j) = 0 |
        i <- row_domain(A),
        j <- column_domain(A),
        index_less(i, j)];


declare is_js :: Boole;

define is_js =
    _runtime_environment = "javascript";

# ------------------------------------------------------------------------------
# Comprehensions
# ------------------------------------------------------------------------------

define comprehensions_suite = test_suite("Comprehension", [
    
    test("should count empty list as zero", () ->
        count[true | x <- []] = 0),

    test("should count true as one", () ->
        count[true | x <- [1, 2, 3]] = 3),

    test("should count false as zero", () ->
        count[false | x <- [1, 2, 3]] = 0),
            
    test("count comprehension should filter correctly I", () ->
        count[mod(x, 2) = 0 | x <- naturals(10)] = 5),
         
    test("count comprehension should filter correctly II", () ->
        count[ x < y | x <- naturals(10), y <- naturals(10)] = 45),
             
    test("all comprehension should be true for empty list", () ->
        all[x | x <- []] = true),
         
    test("some comprehension should be false for empty list", () ->
        some[x | x <- []] = false),
             
    test("all comprehension should be true for non-empty list", () ->
        all[x < 5 | x <- [1,2,3]] = true),
         
    test("some comprehension should be true for non-empty list", () ->
        some[x < 5 | x <- [1,2,3]] = true),
             
    test("all comprehension should be false for non-empty list", () ->
        all[x < 3 | x <- [1,2,3]] = false),
         
    test("some comprehension should be true for non-empty list", () ->
        some[x < 3 | x <- [1,2,3]] = true)
]);


# ------------------------------------------------------------------------------
# Function random
# ------------------------------------------------------------------------------

define random_suite = test_suite("Function random", [
    
    test("should do something", () ->
        let r = random() in
            r >= 0 and r <= 1
        end)
]);


# ------------------------------------------------------------------------------
# Function equal
# ------------------------------------------------------------------------------

define equal_suite = test_suite("Function equal", [
    
    test("should be true for equal indices", () ->
        equal(Bar@v0, Bar@v0)),

    test("should be false for unequal indices", () ->
        not(equal(Bar@v0, Bar@v1))),
   
    test("should be true for equal compound indices", () ->
        equal(Bar@v0%Bar@v1, Bar@v0%Bar@v1)),

    test("should be false for unequal compound indices", () ->
        not(equal(Bar@v0%Bar@v1, Bar@v1%Bar@v0)))         
]);


# ------------------------------------------------------------------------------
# Conversions
# ------------------------------------------------------------------------------

defconv gram_per_kilogram :: gram per kilo:gram;

defconv milligram_per_kilogram :: milli:gram per kilo:gram;

defconv yottagram_per_gram :: yotta:gram per gram;

defunit earthmass "earth" = 5972 * yotta:gram;

defconv earthmass_per_yottagram :: earthmass / yotta:gram;

define defconv_suite = test_suite("defconv", [

    test("should give correct conversion for gram per kilo:gram I", () ->
        gram_per_kilogram = 1000 * |gram per kilo:gram|
    ),

    test("should give correct conversion for gram per kilo:gram II", () ->
        gram_per_kilogram * 50 * |kilo:gram| = 50000 * |gram|
    ),

    test("should give correct conversion for milli:gram per kilo:gram", () ->
        milligram_per_kilogram = 1000000 * |milli:gram per kilo:gram|
    ),

    test("should give correct conversion for yotta:gram per kilo:gram", () ->
        yottagram_per_gram ~= 10^-24 * |yotta:gram per gram|
    ),

    test("should give correct conversion for earthmass per yotta:gram", () ->
        earthmass_per_yottagram = 1/5972 * |earthmass per yotta:gram|
    )
]);
