import testing;

include array_tests;
include bignum_tests;
include comprehension_tests;
include index_tests;
include funcall;
include list_tests;
include map_tests;
include matrix_tests;
include misc_tests;
include set_tests;
include statements_tests;
include string_tests;


declare base_suites :: List(TestSuite);

define base_suites = flatten([
    array_suites,
    bignum_suites,
    comprehension_suites,
    index_suites,
    funcall_suites,
    list_suites,
    map_suites,
    matrix_suites,
    misc_suites,
    set_suites,
    statement_suites,
    string_suites
]);

run_test_suites(base_suites); 