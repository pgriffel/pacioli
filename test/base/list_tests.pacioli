import testing;
import testdata;

declare list_suites :: List(TestSuite);

define list_suites = [
    sort_suite,
    reverse_suite,
    nth_suite,
    # mapnz_suite,  #     does not exist in MVM yet
    distinct_tests    
];

run_test_suites(list_suites); 

# ------------------------------------------------------------------------------
# Function sort
# ------------------------------------------------------------------------------

define sort_suite = test_suite("Function sort", [
    
    test("should sort ascending", () ->
        sort_list([1, 9, 3, 2, 5], (x, y) -> x - y) = [1, 2, 3, 5, 9]),
            
    test("should sort decending", () ->
        sort_list([1, 9, 3, 2, 5], (x, y) -> y - x) = [9, 5, 3, 2, 1])
]);

# ------------------------------------------------------------------------------
# Function reverse
# ------------------------------------------------------------------------------

define reverse_suite = test_suite("Function reverse", [
    
    test("should reverse the empty list", () ->
        reverse([]) = []),

    test("should reverse a list of numbers correctly", () ->
        reverse([1, 9, 3, 2, 5]) = [5, 2, 3, 9, 1])
]);

# ------------------------------------------------------------------------------
# Function nth
# ------------------------------------------------------------------------------

define nth_suite = test_suite("Function nth", [
    
    test("should get 0-th element", () ->
        nth(0, [1, 9, 3, 2, 5]) = 1),

    test("should get last element", () ->
        nth(4, [1, 9, 3, 2, 5]) = 5)
]);

# ------------------------------------------------------------------------------
# Function mapnz
# ------------------------------------------------------------------------------

define mapnz_suite = test_suite("Function mapnz", [
    
    test("should do something", () ->
        mapnz((x) -> x + 1, test_vec(0, 0, 1, 0, 3, 4)) = test_vec(0, 0, 2, 0, 4, 5))
]);

# ------------------------------------------------------------------------------
# Function distinct
# ------------------------------------------------------------------------------

define distinct_tests = test_suite("Function distinct", [
    test("should give the empty list for an empty list", () ->
        distinct([]) = []),

    test("should give the original list for a singleton list", () ->
        distinct([1]) = [1]),

    test("should remove duplicates from a pair of 1s", () ->
        distinct([1, 1]) = [1]),

    test("should remove duplicates from a longer list", () ->
        distinct([1, 2, 1, 3, 2, 1, 2, 3]) = [1, 2, 3]),

    test("should remove duplicates from a list of lists", () ->
        distinct([[1, 2], [1, 1], [2, 1], [1, 2], [1, 2], [2, 1], [1, 1]]) =
            [[1, 2], [1, 1], [2, 1]]),

    random_test("should give a list containing all elements from the original list exactly once", () ->
        let 
            list = random_short_string_list(),
            without_duplicates = distinct(list)
        in
            just(all[count[x = elt | x <- without_duplicates] = 1 | elt <- list])
        end),

    random_test("should give a list containing just elements from the original list", () ->
        let 
            list = random_short_string_list(),
            without_duplicates = distinct(list)
        in
            just(all[contains(list, elt) | elt <- without_duplicates])
        end)
]);